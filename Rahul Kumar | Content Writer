<style>
:root {
    --p: #2563eb;
    --p-hover: #1d4ed8;
    --d: #0f172a;
    --bg: #eef4ff;
    --text: #333;
}
* {
    box-sizing: border-box;
    scroll-behavior: smooth;
}
body {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(180deg, var(--bg), #fff);
    color: var(--text);
    line-height: 1.6;
}
.hero {
    padding: 100px 8%;
    background: linear-gradient(135deg, #2563eb, #0f172a);
    color: #fff;
    text-align: center;
}
.hero h1 {
    font-size: 56px;
    margin: 0 0 10px 0;
    letter-spacing: -1px;
}
.hero p {
    font-size: 20px;
    opacity: 0.95;
    max-width: 600px;
    margin: 0 auto 20px auto;
}
.btn {
    display: inline-block;
    margin: 8px 10px 0 0;
    padding: 12px 28px;
    border-radius: 40px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
}
.b1 {
    background: #fff;
    color: var(--p);
}
.b1:hover {
    background: #f8fafc;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255,255,255,0.2);
}
.b2 {
    border: 2px solid #fff;
    color: #fff;
}
.b2:hover {
    background: rgba(255,255,255,0.1);
    transform: translateY(-2px);
}
.wrap {
    max-width: 1200px;
    margin: auto;
    padding: 60px 20px;
}
.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
    margin-bottom: 24px;
}
.card {
    background: rgba(255,255,255,0.8);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.5);
    border-radius: 22px;
    padding: 30px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.04);
    transition: all 0.3s ease;
}
.card:hover {
    transform: translateY(-6px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.08);
}
h2 {
    color: var(--d);
    margin-top: 0;
    font-size: 24px;
    border-bottom: 2px solid var(--bg);
    padding-bottom: 10px;
}
h3 {
    color: var(--p);
    margin: 0 0 5px 0;
}
.timeline {
    border-left: 3px solid var(--p);
    padding-left: 20px;
    margin-left: 10px;
}
.badge {
    display: inline-block;
    background: #dbeafe;
    color: var(--p-hover);
    padding: 6px 12px;
    border-radius: 20px;
    margin: 4px;
    font-size: 13px;
    font-weight: 600;
}
.bar {
    margin: 16px 0;
}
.bar div:first-child {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 4px;
}
.track {
    height: 8px;
    background: #e2e8f0;
    border-radius: 20px;
    overflow: hidden;
}
.fill {
    height: 100%;
    background: var(--p);
    border-radius: 20px;
}
.metric {
    font-size: 42px;
    font-weight: 700;
    color: var(--p);
    line-height: 1;
    margin-bottom: 5px;
}

/* Portfolio Specific Styles */
.portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
    margin-bottom: 40px;
}
.sample-card {
    background: #fff;
    border-radius: 16px;
    padding: 24px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 6px rgba(0,0,0,0.02);
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
}
.sample-card:hover {
    transform: translateY(-5px);
    border-color: var(--p);
    box-shadow: 0 10px 20px rgba(37,99,235,0.1);
}
.sample-meta {
    font-size: 12px;
    color: #64748b;
    margin-bottom: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
}
.sample-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--d);
    margin: 0 0 12px 0;
    line-height: 1.4;
}
.sample-desc {
    font-size: 14px;
    color: #475569;
    margin-bottom: 20px;
    flex-grow: 1;
}
.read-more {
    color: var(--p);
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    transition: gap 0.3s;
}
.read-more:hover {
    gap: 8px;
}

footer {
    background: var(--d);
    color: #fff;
    padding: 30px;
    text-align: center;
    font-size: 14px;
    opacity: 0.9;
